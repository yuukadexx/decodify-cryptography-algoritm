# ============================================
# DecoDify - SQLite Optimized Configuration
# ============================================
# Copy this file to .env and adjust values as needed
# WARNING: Never commit .env to version control!

# ===============================
# Flask Application
# ===============================
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
APP_NAME=DecoDify
APP_VERSION=1.0.0
APP_DESCRIPTION=Interactive Cryptography Learning Platform
APP_AUTHOR=DecoDify Team

# ===============================
# Security & Authentication
# ===============================
# Generate new: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=fee9168bc59758cd3124fcc8b6b05c5f21d6e8f55b2ca8a574e203dadc15e292

# Argon2 Password Hashing (optimized for SQLite)
ARGON2_TIME_COST=1              # Lower for SQLite performance
ARGON2_MEMORY_COST=1024         # 1KB (lower memory usage for SQLite)
ARGON2_PARALLELISM=1            # Single thread for SQLite

# Session Security
SESSION_COOKIE_NAME=decodify_session
SESSION_COOKIE_SECURE=0         # 0 for HTTP, 1 for HTTPS only
SESSION_COOKIE_HTTPONLY=1       # 1 prevents JavaScript access
SESSION_COOKIE_SAMESITE=Lax     # Lax, Strict, or None
SESSION_LIFETIME_MINUTES=30     # Session timeout in minutes

# ===============================
# SQLite Database Configuration
# ===============================
DATABASE_NAME=crypto.db
DATABASE_URL=sqlite:///instance/crypto.db
TEST_DATABASE_URL=sqlite:///:memory:

# SQLite Performance Optimizations
SQLITE_JOURNAL_MODE=WAL         # WAL (Write-Ahead Logging) for better concurrency
SQLITE_SYNCHRONOUS=NORMAL       # NORMAL (good balance), FULL (safer), OFF (fastest)
SQLITE_CACHE_SIZE=-2000         # Cache size in pages (-2000 = ~2MB)
SQLITE_TEMP_STORE=MEMORY        # Store temp tables in MEMORY (fastest)
SQLITE_LOCKING_MODE=NORMAL      # NORMAL or EXCLUSIVE
SQLITE_TIMEOUT=30               # Connection timeout in seconds
SQLITE_CHECK_SAME_THREAD=0      # 0 for multi-thread, 1 for single-thread
SQLITE_AUTO_VACUUM=0            # 0=NONE, 1=FULL, 2=INCREMENTAL

# SQLAlchemy Settings
SQLALCHEMY_TRACK_MODIFICATIONS=0
SQLALCHEMY_ECHO=1               # 1 to log SQL queries (development)
SQLALCHEMY_ENGINE_OPTIONS={"poolclass": "StaticPool", "connect_args": {"check_same_thread": False, "timeout": 30}}

# ===============================
# Email Configuration (Development - Mailtrap)
# ===============================
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=8af2cb84cfc5b6
MAIL_PASSWORD=d1620a3c08deea
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_DEFAULT_SENDER_NAME=DecoDify
MAIL_DEFAULT_SENDER_EMAIL=noreply@decodify.com
MAIL_SUPPRESS_SEND=1            # 1 = don't actually send emails (development)
MAIL_DEBUG=0                    # 1 for SMTP debug output

# ===============================
# Feature Flags
# ===============================
ENABLE_CHATBOT=1                # AI Chatbot feature
ENABLE_GLOSSARY=1               # Cryptography glossary
ENABLE_PREMIUM=1                # Premium subscription
ENABLE_QUIZZES=1                # Interactive quizzes
ENABLE_CHALLENGES=1             # Coding challenges
ENABLE_LEADERBOARD=1            # User rankings
ENABLE_SQLITE_STATS=1           # Collect SQLite statistics

# ===============================
# Cipher Algorithm Limits
# ===============================
MAX_RAIL_FENCE_RAILS=5          # Maximum rails for Rail Fence
MAX_SPIRAL_SIZE=5               # Maximum spiral matrix size
MAX_BRUTEFORCE_SHIFTS=26        # Caesar cipher shifts to try
MAX_VIGENERE_KEY_LENGTH=50      # Max Vigenere key length
MAX_HILL_MATRIX_SIZE=3          # Max Hill cipher matrix size (2x2 or 3x3)
MAX_TEXT_LENGTH=5000            # Maximum input text length for ciphers

# ===============================
# Rate Limiting (Conservative for SQLite)
# ===============================
RATELIMIT_ENABLED=1
RATELIMIT_DEFAULT=100/day;20/hour    # General rate limits
RATELIMIT_API=200/day;50/hour        # API endpoints
RATELIMIT_AUTH=10/hour               # Authentication endpoints
RATELIMIT_CIPHER=50/hour             # Cipher operations

# ===============================
# File Upload & Storage (SQLite friendly)
# ===============================
MAX_CONTENT_LENGTH=10485760     # 10MB (10 * 1024 * 1024)
ALLOWED_EXTENSIONS=txt,png,jpg,jpeg,gif,pdf
UPLOAD_CHUNK_SIZE=1024          # 1KB chunks for SQLite
MAX_UPLOADS_PER_USER=20         # Conservative limit for SQLite

# ===============================
# Cache Settings (Important for SQLite Performance)
# ===============================
ENABLE_MEMORY_CACHE=1           # Enable in-memory caching
CACHE_TTL_SECONDS=300           # Cache time-to-live (5 minutes)
CACHE_MAX_SIZE=1000             # Maximum cache items
CACHE_TYPE=simple               # simple, filesystem, redis, memcached

# ===============================
# Batch Operations (Optimized for SQLite)
# ===============================
BATCH_INSERT_SIZE=100           # Insert records in batches
BATCH_UPDATE_SIZE=50            # Update records in batches
BULK_OPERATION_THRESHOLD=10     # Use bulk operations for > N records

# ===============================
# Chatbot Settings
# ===============================
CHATBOT_MAX_HISTORY=50          # Number of messages to remember
CHATBOT_RESPONSE_TIMEOUT=30     # Seconds to wait for response
CHATBOT_MODEL_PATH=             # Path to custom model (optional)

# ===============================
# Quiz & Challenge Settings
# ===============================
QUIZ_TIME_LIMIT_MINUTES=30      # Time limit per quiz
QUIZ_MAX_QUESTIONS=20           # Questions per quiz
QUIZ_PASSING_SCORE=70           # Minimum score to pass (%)
QUIZ_MAX_ATTEMPTS=3             # Attempts per quiz
MAX_CHALLENGE_ATTEMPTS=5        # Attempts per challenge
CHALLENGE_COOLDOWN_MINUTES=5    # Time between attempts
XP_PER_CORRECT_ANSWER=10        # XP for correct answers
XP_PER_CHALLENGE=50             # XP for completing challenge

# ===============================
# Premium & Payments
# ===============================
PREMIUM_PRICE_MONTHLY=9.99
PREMIUM_PRICE_YEARLY=99.99
PREMIUM_PRICE_LIFETIME=199.99
PREMIUM_CURRENCY=USD
PREMIUM_TRIAL_DAYS=7            # Free trial period

# ===============================
# SQLite Maintenance & Monitoring
# ===============================
SQLITE_VACUUM_INTERVAL_DAYS=7   # Run VACUUM every 7 days
SQLITE_ANALYZE_INTERVAL_HOURS=24 # Run ANALYZE every 24 hours
ENABLE_SQLITE_BACKUP=1          # Enable automatic backups
BACKUP_INTERVAL_HOURS=24        # Backup every 24 hours
MAX_BACKUP_FILES=7              # Keep last 7 backup files
SQLITE_MONITOR_INTERVAL_MINUTES=60 # Monitor database every hour
SQLITE_ALERT_SIZE_MB=100        # Alert if database > 100MB

# ===============================
# Logging Configuration (SQLite focused)
# ===============================
LOG_LEVEL=INFO                  # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_MAX_SIZE_MB=5               # Max log file size (5MB)
LOG_BACKUP_COUNT=3              # Number of backup log files
LOG_SQL_QUERIES=1               # Log SQL queries (development)
LOG_SLOW_QUERIES_MS=100         # Log queries slower than 100ms
LOG_QUERY_PLANS=0               # Log query execution plans

# ===============================
# API Settings
# ===============================
API_PREFIX=/api/v1
API_RATE_LIMIT=100 per hour

# ===============================
# CORS (Cross-Origin Resource Sharing)
# ===============================
CORS_ENABLED=0                  # Enable for API access from other domains
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With

# ===============================
# Development & Testing Settings
# ===============================
TESTING=0                       # 1 for test environment
AUTO_RELOAD=1                   # Auto-reload on code changes
PROFILING_ENABLED=0             # Enable performance profiling
ENABLE_SQLITE_EXPLAIN=1         # Explain query plans
SQLITE_DEBUG=0                  # SQLite debug mode

# ===============================
# User Experience Settings
# ===============================
DEFAULT_LANGUAGE=en             # en, id, etc.
TIMEZONE=UTC
DATE_FORMAT=YYYY-MM-DD
ITEMS_PER_PAGE=12               # Pagination items per page
ENABLE_DARK_MODE=1              # Dark/light theme toggle
ANIMATIONS_ENABLED=1            # UI animations
NOTIFICATIONS_ENABLED=1         # Browser notifications

# ===============================
# External Services (Optional - Uncomment to use)
# ===============================
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_ANALYTICS_ID=
# OPENAI_API_KEY=
# STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

# ===============================
# File Paths (Auto-created)
# ===============================
# These paths are relative to project root
# instance/ - Database, logs, uploads
# instance/logs/ - Application logs
# instance/uploads/ - User uploads
# instance/backups/ - Database backups
# instance/cache/ - Cache files

# ===============================
# Performance Notes for SQLite
# ===============================
# 1. WAL mode improves concurrent reads/writes
# 2. Cache size affects memory usage vs performance
# 3. Batch operations reduce transaction overhead
# 4. Memory cache reduces database queries
# 5. Regular VACUUM maintains performance
# 6. ANALYZE helps query optimizer